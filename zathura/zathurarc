#Bruker systemets utklipstavle
set selection-clipboard clipboard
#Viser scrollbar opp og ned
set guioptions "sv"
# Ctrl-P som hurtigtast for utskrift
map <C-p> print
# Transparent gul farge for utheving
set highlight-color "rgba(255, 255, 0, 0.4)"
set highlight-active-color "rgba(255, 255, 0, 0.6)"
#Bakgrunn på statusbar som på vindusramma
set statusbar-bg "#444444"
# Hvit skrift når vi skriver inn kommandoer
set inputbar-fg "#FFFFFF"
#10 pix mellom sidene 
set page-v-padding 10
set page-h-padding 10
# ~ isteden for /home/tor i statuslinja
set statusbar-home-tilde true
# filnavn, ikke full sti, i tittel på vinduet
set window-title-basename true
