# .conkyrc
conky.config = {
    alignment = 'bottom_right',
    background = false,
    cpu_avg_samples = 2,
    double_buffer = true,
  --  font = 'JetBrains Mono:size=16',
    font = 'TerminessNerdFontMono-Bold:size=16',
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    update_interval = 1.0,
    usb_dioxane = 0,
    stencil = false,
    
    -- Wayland specific settings
    out_to_x = false,
    out_to_wayland = true,
    own_window = true,
    own_window_type = 'normal',
    own_window_transparent = true,
    own_window_argb_visual = true,

    
    -- Size and Position
    minimum_width = 220,
    minimum_height = 400,
    gap_x = 30,
    gap_y = 50,
}

conky.text = [[
$hr
${color grey}Uptime:$color $uptime
${color grey}CPU Usage:$color $cpu% ${cpubar 4}
${color grey}RAM Usage:$color $mem/$memmax ($memperc%)
${color grey}Disk Usage:$color ${fs_used /}/${fs_size /}
$hr
${color grey}Name              PID   CPU%   MEM%
${color #cc6666} ${top name 1} ${top pid 1} ${top cpu 1} ${top mem 1}
${color #e6c547} ${top name 2} ${top pid 2} ${top cpu 2} ${top mem 2}
${color #98c379} ${top name 3} ${top pid 3} ${top cpu 3} ${top mem 3}
${color white}Nye meldinger :${execi 300 /home/tor/Scripts/SjekkPost}
]]
